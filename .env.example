# --- Deployment (scripts/deploy.sh, Terraform, GitHub Actions) -------------
AWS_ACCOUNT_ID=your_12_digit_account_id
DEFAULT_AWS_REGION=us-east-1
PROJECT_NAME=twin

# --- Backend runtime (backend/.env for local dev; set on the Lambda in prod) ---
# Credentials come from the standard AWS chain (profile, SSO, or the Lambda role).
# Never put an access key in this file or in frontend code.
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
CORS_ORIGINS=http://localhost:3000
# Conversation memory: local files by default, S3 in production.
USE_S3=false
S3_BUCKET=
MEMORY_DIR=../memory
# Optional tuning (defaults shown)
# MEMORY_TTL_DAYS=30
# MAX_HISTORY_MESSAGES=20
# MAX_HISTORY_CHARS=12000
# MAX_SESSION_MESSAGES=80
# MAX_OUTPUT_TOKENS=1200
# BEDROCK_READ_TIMEOUT=24
# RATE_LIMIT_PER_MINUTE=15
# ENABLE_DOCS=false
# MODEL_PRICING_JSON={"your-model-id":[0.06,0.24]}   # USD per 1M tokens [input, output], for cost logging; unknown models log null

# --- Frontend (frontend/.env.local for dev; scripts/deploy.sh writes .env.production) ---
# This is only the public URL of the API. It is not a secret.
# NEXT_PUBLIC_API_URL=http://localhost:8000
